# Supabase
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxx...

# Anthropic Claude API (for frontend - with dangerous direct browser access)
VITE_ANTHROPIC_API_KEY=sk-ant-xxx

# Stripe Public Key (for frontend)
VITE_STRIPE_PUBLIC_KEY=pk_test_xxx

# Stripe Price IDs
VITE_STRIPE_PRICE_MONTHLY=price_xxx
VITE_STRIPE_PRICE_YEARLY=price_yyy
VITE_STRIPE_PRICE_SINGLE=price_zzz

# Backend only (Netlify Functions) - DO NOT prefix with VITE_
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: Supabase Service Key for webhook (if different from anon key)
SUPABASE_SERVICE_KEY=eyJxxx...
