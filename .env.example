# ===========================================
# FRONTEND (VITE_* = exposed to browser)
# ===========================================

# Supabase
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxx...

# Stripe Public Key (safe to expose)
VITE_STRIPE_PUBLIC_KEY=pk_test_xxx

# Stripe Price IDs
VITE_STRIPE_PRICE_MONTHLY=price_xxx
VITE_STRIPE_PRICE_YEARLY=price_yyy

# ===========================================
# BACKEND ONLY (Netlify Functions - NEVER expose)
# ===========================================

# Anthropic Claude API (server-side only!)
ANTHROPIC_API_KEY=sk-ant-xxx

# Stripe Secret (server-side only!)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase Service Key (server-side only!)
SUPABASE_SERVICE_KEY=eyJxxx...

# Google Places API
GOOGLE_PLACES_API_KEY=AIza...

# Brave Search API (optional)
BRAVE_SEARCH_API_KEY=BSA...
